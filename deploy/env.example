# Copy to .env.production on the Raspberry Pi and fill in values.
#   cp deploy/env.example .env.production

# Required — copy from config/master.key on your dev machine:
RAILS_MASTER_KEY=

# App URL (Pi IP or domain). Examples:
#   APP_HOST=192.168.0.50
#   APP_HOST=order.example.com
APP_HOST=192.168.0.50
APP_PROTOCOL=http

# Home/LAN without HTTPS (typical for Pi on local network):
FORCE_SSL=false
ASSUME_SSL=false
DISABLE_HOST_CHECK=true

# Optional logging
RAILS_LOG_LEVEL=info

# Optional — password reset & order emails (Gmail example):
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true
