#!/usr/bin/env bash
# Run on the Pi: bin/pi-diagnose
set -euo pipefail

cd "$(dirname "$0")/.."

echo "=== IP addresses ==="
hostname -I

echo
echo "=== Docker ==="
docker compose ps 2>/dev/null || docker-compose ps

echo
echo "=== Container env (host/ssl) ==="
docker compose exec web printenv 2>/dev/null | grep -E 'APP_HOST|DISABLE_HOST|FORCE_SSL|RAILS_MASTER' || echo "(container not running)"

echo
echo "=== Waiting for boot (Pi can take ~60s) ==="
for i in 1 2 3 4 5 6; do
  code=$(curl -sS -o /dev/null -w "%{http_code}" http://127.0.0.1:3000/up 2>/dev/null || echo "000")
  echo "attempt $i: HTTP $code"
  if [[ "$code" == "200" ]]; then break; fi
  sleep 10
done

echo
echo "=== curl localhost:3000/up ==="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" http://127.0.0.1:3000/up || echo "FAILED"

echo
echo "=== curl LAN IP ==="
LAN_IP=$(hostname -I | awk '{print $1}')
curl -sS -o /dev/null -w "HTTP %{http_code}\n" "http://${LAN_IP}:3000/up" || echo "FAILED"

echo
echo "=== curl /login (browser UA) ==="
curl -sS -o /dev/null -w "HTTP %{http_code}\n" \
  -A "Mozilla/5.0 Chrome/120.0.0.0" \
  "http://${LAN_IP}:3000/login" || echo "FAILED"

echo
echo "=== Last 40 log lines ==="
docker compose logs web --tail 40 2>/dev/null

if docker compose ps 2>/dev/null | grep -q Restarting; then
  echo
  echo "=== Container is crash-looping. Run: ==="
  echo "docker compose logs web --tail 100"
  echo "sudo chown -R 1000:1000 \$(docker volume inspect bbq-rice-order-system_sqlite_data -f '{{.Mountpoint}}')"
fi

echo
echo "=== Try in browser ==="
echo "http://${LAN_IP}:3000"
