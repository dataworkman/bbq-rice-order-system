<%= form_with model: [:admin, @product] do |f| %>
  <% if @product.errors.any? %>
    <div class="flash alert"><%= @product.errors.full_messages.join(", ") %></div>
  <% end %>

  <div class="form-group">
    <%= f.label :item_number, t("app.admin.products.form.item_number") %>
    <%= f.text_field :item_number, required: true, placeholder: "BUN-001" %>
  </div>
  <div class="form-group">
    <%= f.label :name, t("app.admin.products.form.name") %>
    <%= f.text_field :name, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :category, t("app.admin.products.form.category") %>
    <%= f.text_field :category, required: true, placeholder: t("app.admin.products.form.category_hint") %>
  </div>
  <div class="form-group">
    <%= f.label :unit_price_dollars, t("app.admin.products.form.unit_price") %>
    <%= f.number_field :unit_price_dollars, min: 0.01, step: 0.01, required: true, value: @product.unit_price_dollars %>
  </div>
  <div class="form-group">
    <%= f.label :stock, t("app.admin.products.form.stock") %>
    <%= f.number_field :stock, min: 0, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :unit, t("app.admin.products.form.unit") %>
    <%= f.text_field :unit, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :active, t("app.admin.products.form.active") %>
    <%= f.select :active, [[t("app.admin.products.active"), true], [t("app.admin.products.inactive"), false]] %>
  </div>

  <%= f.submit t("app.admin.products.save"), class: "btn btn-primary" %>
  <%= link_to t("app.admin.products.list"), admin_products_path, class: "btn btn-secondary" %>
<% end %>
