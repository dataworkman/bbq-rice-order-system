<div class="login-page">
  <div class="login-logo">
    <%= image_tag "logo.png", alt: "BBQ + RICE", class: "login-logo__img" %>
  </div>

  <div class="card login-card">
    <h1><%= t("app.sessions.title") %></h1>

    <%= form_with url: login_path, method: :post do |f| %>
      <div class="form-group">
        <%= label_tag :email, t("app.sessions.email") %>
        <%= email_field_tag :email, params[:email], required: true, autofocus: true, placeholder: "owner1@example.com" %>
      </div>
      <div class="form-group">
        <%= label_tag :password, t("app.sessions.password") %>
        <%= password_field_tag :password, nil, required: true, placeholder: "password123" %>
      </div>
      <%= submit_tag t("app.sessions.login"), class: "btn btn-primary" %>
    <% end %>

    <p class="login-links">
      <%= link_to t("app.password_reset.forgot"), new_password_reset_path %>
    </p>

    <hr>
    <p style="font-size:0.9rem;color:var(--muted)">
      <%= t("app.sessions.test_accounts", owner: "owner1@example.com", admin: "admin@hq.com") %><br>
      <%= t("app.sessions.test_password", password: "password123") %>
    </p>
  </div>
</div>
