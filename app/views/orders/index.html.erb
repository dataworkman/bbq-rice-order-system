<% content_for :title, t("app.orders.title") %>

<h1><%= t("app.orders.title") %></h1>

<% if @orders.empty? %>
  <div class="card"><p><%= t("app.orders.empty") %></p></div>
<% else %>
  <table class="stack-table">
    <thead>
      <tr>
        <th><%= t("app.orders.order_no") %></th>
        <th><%= t("app.orders.datetime") %></th>
        <th><%= t("app.orders.status") %></th>
        <th><%= t("app.orders.total") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td data-label="<%= t("app.orders.order_no") %>">#<%= order.id %></td>
          <td data-label="<%= t("app.orders.datetime") %>"><%= l(order.created_at, format: :long) %></td>
          <td data-label="<%= t("app.orders.status") %>"><span class="badge badge-<%= order.status %>"><%= order.status_label %></span></td>
          <td data-label="<%= t("app.orders.total") %>"><%= format_money(order.total_amount) %></td>
          <td class="stack-table__actions" data-label=""><%= link_to t("app.orders.detail"), order_path(order), class: "btn btn-secondary btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
