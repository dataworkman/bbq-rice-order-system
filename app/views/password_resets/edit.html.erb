<div class="login-page">
  <div class="login-logo">
    <%= image_tag "logo.png", alt: "BBQ + RICE", class: "login-logo__img" %>
  </div>

  <div class="card login-card">
    <h1><%= t("app.password_reset.reset_title") %></h1>
    <p><%= t("app.password_reset.reset_subtitle") %></p>

    <%= form_with model: @user, url: password_reset_path(token: params[:token]), method: :patch do |f| %>
      <% if @user.errors.any? %>
        <div class="flash alert"><%= @user.errors.full_messages.join(", ") %></div>
      <% end %>

      <div class="form-group">
        <%= f.label :password, t("app.account.new_password") %>
        <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password" %>
      </div>
      <div class="form-group">
        <%= f.label :password_confirmation, t("app.account.password_confirmation") %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
      </div>

      <%= f.submit t("app.password_reset.save"), class: "btn btn-primary" %>
    <% end %>

    <p class="login-links">
      <%= link_to t("app.password_reset.back_to_login"), login_path %>
    </p>
  </div>
</div>
