<%= t("app.mailer.text_greeting", name: @franchise.name, id: @order.id) %>

<%= t("app.mailer.ordered_at") %>: <%= l(@order.created_at, format: :long) %>
<%= t("app.mailer.address") %>: <%= @franchise.address %>
<%= t("app.mailer.status") %>: <%= @order.status_label %>

<%= t("app.mailer.text_items") %>
<% @items.each do |item| %>
- [<%= item.display_item_number %>] <%= item.product.name %>: <%= item.quantity %><%= item.product.unit %> x <%= format_money(item.unit_price) %> = <%= format_money(item.subtotal) %>
<% end %>

<%= t("app.mailer.text_invoice") %>
<%= t("app.mailer.supply_amount") %>: <%= format_money(@order.total_amount) %>
<%= t("app.mailer.tax") %>: <%= format_money(@tax) %>
<%= t("app.mailer.grand_total") %>: <%= format_money(@grand_total) %>

<%= t("app.mailer.issued_at", date: l(Date.current, format: :long)) %>

<%= t("app.mailer.delivery_note") %>
