<h1><%= t("app.account.title") %></h1>

<div class="card">
  <p><strong><%= t("app.account.email") %>:</strong> <%= current_user.email %></p>
  <p><strong><%= t("app.account.role") %>:</strong> <%= t("app.account.roles.#{current_user.role}") %></p>
</div>

<div class="card">
  <%= form_with url: account_path, method: :patch, scope: :account do |f| %>
    <div class="form-group">
      <%= f.label :current_password, t("app.account.current_password") %>
      <%= f.password_field :current_password, required: true, autocomplete: "current-password" %>
    </div>
    <div class="form-group">
      <%= f.label :password, t("app.account.new_password") %>
      <%= f.password_field :password, required: true, autocomplete: "new-password" %>
    </div>
    <div class="form-group">
      <%= f.label :password_confirmation, t("app.account.password_confirmation") %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <%= f.submit t("app.account.save"), class: "btn btn-primary" %>
    <%= link_to t("app.account.cancel"), (current_user.admin? ? admin_root_path : root_path), class: "btn btn-secondary" %>
  <% end %>
</div>
